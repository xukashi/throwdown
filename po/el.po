#: data/io.github.yioannides.Throwdown.desktop.in:2
#: data/io.github.yioannides.Throwdown.metainfo.xml.in:7 src/gtk/window.ui:10
msgid "Throwdown"
msgstr "Throwdown"

#. Don't translate the semicolons!
#: data/io.github.yioannides.Throwdown.desktop.in:9
msgid "skateboard;skate;trick;challenge;"
msgstr "σκέϊτμπορντ;σκέϊτ;κόλπο;πρόκληση;"

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:8
msgid "Improve your skateboarding skills!"
msgstr "Βελτίωσε τις ικανότητες σου στο σκέϊτμπορντινγκ!"

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:10
msgid ""
"Throwdown is a minimal GNOME app for generating random skateboarding trick "
"sequences! Features include:"
msgstr ""
"Το Throwdown είναι μια εφαρμογή για το GNOME για να παράγεις τυχαίες "
"ακολουθείες κόλπων του σκέϊτμπορντ! Κάποια χαρακτηριστικά:"

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:12
msgid "Three levels of difficulty (easy, medium, hard) and random mode"
msgstr "Τρία επίπεδα δυσκολίας (εύκολο, μέτριο, δύσκολο) και τυχαίο"

#. Translate as much as your language allows you to, but using the original words is not a problem either
#: data/io.github.yioannides.Throwdown.metainfo.xml.in:14
msgid ""
"Type of modules: stance, direction, spin, flip, grind, late flip and ground "
"tricks"
msgstr ""
"Τύποι δομοστοιχείων: στάση, πορεία, περιστροφή, flip, grind, late flip και "
"κόλπα εδάφους"

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:15
msgid "Named tricks (example: Fakie BS 360 -> Full Cab)"
msgstr "Επώνυμα κόλπα (παράδειγμα: Fakie BS 360 -> Full Cab)"

#: data/io.github.yioannides.Throwdown.metainfo.xml.in:45
msgid "Main window"
msgstr "Κυρίως παράθυρο"

#: src/gtk/window.ui:20
msgid "Difficulty"
msgstr "Δυσκολία"

#: src/gtk/window.ui:28
msgid "Main Menu"
msgstr "Κυρίως μενού"

#: src/gtk/window.ui:41
msgid "Welcome"
msgstr "Καλωσόρισμα"

#. To be translated informally (but politely, like "What's up?")
#: src/gtk/window.ui:71
msgid "Hey! What's good?"
msgstr "Γειά! Πώς πάει;"

#: src/gtk/window.ui:82
msgid "Choose your difficulty to get started!"
msgstr "Επέλεξε το επίπεδο δυσκολίας και ξεκίνα!"

#: src/gtk/window.ui:97
msgid "Trick"
msgstr "Κόλπο"

#. For context: the full string is "Press <space> for a new trick!"
#: src/gtk/window.ui:153
msgid "Press"
msgstr "Πάτα"

#. For context: the full string is "Press <space> for a new trick!"
#: src/gtk/window.ui:164
msgid "for a new trick!"
msgstr "για καινούργιο κόλπο!"

#: src/gtk/window.ui:180 src/window.py:59
msgid "Easy"
msgstr "Εύκολο"

#: src/gtk/window.ui:184 src/window.py:60
msgid "Medium"
msgstr "Μέτριο"

#: src/gtk/window.ui:188 src/window.py:61
msgid "Hard"
msgstr "Δύσκολο"

#: src/gtk/window.ui:193 src/window.py:62
msgid "Random"
msgstr "Τυχαίο"

#: src/gtk/window.ui:201
msgid "About Throwdown"
msgstr "Περί του Throwdown"

