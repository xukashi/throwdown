<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (C) 2026 yiannis ioannides <git@yioannides.com> -->
<component type="desktop-application">
  <id>dev.yioannides.Throwdown</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Throwdown</name>
  <summary>Improve your skateboarding skills!</summary>
  <description>
    <p>Throwdown is a minimal GNOME app for generating random skateboarding trick sequences! Features include:</p>
    <ul>
      <li>Three levels of difficulty (easy, medium, hard) and random mode</li>
       <!-- Translate as much as your language allows you to, but using the original words is not a problem either -->
      <li>Type of modules: stance, direction, spin, flip, grind, late flip and ground tricks</li>
      <li>Named tricks (example: Fakie BS 360 -> Full Cab)</li>
    </ul>
  </description>

  <url type="homepage">https://github.com/yioannides/throwdown/</url>
  <url type="bugtracker">https://github.com/yioannides/throwdown/issues/</url>
  <url type="vcs-browser">https://github.com/yioannides/throwdown/issues/</url>
  <!-- <url type="contribute">https://example.org/contribute</url> -->
  <!-- <url type="translate">https://example.org/translate</url> -->

  <translation type="gettext">throwdown</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">dev.yioannides.Throwdown.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#9ca2e3</color>
    <color type="primary" scheme_preference="dark">#263981</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/yioannides/throwdown/main/data/screenshots/throwdown-ui.png</image>
      <caption>Main window</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="26.08" date="2026-08-12">
      <description translate="no">
        <p>Initial release</p>
      </description>
    </release>
  </releases>

</component>
