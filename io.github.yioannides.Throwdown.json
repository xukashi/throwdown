{
    "id": "io.github.yioannides.Throwdown",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "throwdown",

    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],

    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],

    "modules": [
        {
            "name": "throwdown",
            "builddir": true,
            "buildsystem": "meson",

            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/yioannides/throwdown.git",
                    "branch": "master"
                }
            ],

            "config-opts": [
                "--libdir=lib"
            ]
        }
    ],

    "build-options": {
        "env": {}
    }
}
